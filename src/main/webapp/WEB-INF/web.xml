<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
	id="WebApp_ID" version="6.1" metadata-complete="true">


	<welcome-file-list>
   		<welcome-file>web/appInitialize</welcome-file>   
 	</welcome-file-list>
	
	  <!-- The HCSSecurityFilter must be first filter !! -->
	<filter>
		<filter-name>HCSSecurityFilter</filter-name>
		<filter-class>
		gov.ny.health.hcs.fwrk.security.HCSSecurityFilter
		</filter-class>
	</filter>
	<filter>
		<filter-name>ServiceConsumerSecurityFilter</filter-name>
		<filter-class>
		us.ny.state.health.hin.srvs.filter.ServiceConsumerSecurityFilter
		</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>HCSSecurityFilter</filter-name>
		<url-pattern>*</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>ServiceConsumerSecurityFilter</filter-name>
		<url-pattern>*</url-pattern>
	</filter-mapping>
		
	<servlet>
		<servlet-name>spring</servlet-name>
		<servlet-class>
			org.springframework.web.servlet.DispatcherServlet
		</servlet-class>
		  <init-param> 
        	<param-name>contextConfigLocation</param-name> 
        	<param-value> 
               /WEB-INF/classes/spring-config.xml 
        </param-value> 
    		</init-param> 
		<load-on-startup>1</load-on-startup>
		<!-- was CommonsMultipartResolver maxUploadSize=409657600 (whole request) -->
		<multipart-config>
			<max-file-size>409657600</max-file-size>
			<max-request-size>409657600</max-request-size>
		</multipart-config>
	</servlet>
		
	<servlet-mapping>
		<servlet-name>spring</servlet-name>
		<url-pattern>/web/*</url-pattern>
	</servlet-mapping>	
	
	<listener>
		<listener-class>
             gov.ny.state.doh.bhae.nyehms.web.spring.listener.NYEHMSAppServletContextListener 
        </listener-class>
   </listener>
   	
 
 

	<!-- was weblogic.xml <timeout-secs>1800</timeout-secs> -->
	<session-config>
		<session-timeout>30</session-timeout>
	</session-config>
	<!-- container data sources, defined in META-INF/context.xml -->
	<resource-ref>
		<res-ref-name>jdbc/BHAE_NYEHMS_DS_ONE_GL</res-ref-name>
		<res-type>javax.sql.DataSource</res-type>
		<res-auth>Container</res-auth>
	</resource-ref>
	<resource-ref>
		<res-ref-name>jdbc/BHAE_NYEHMS_URS</res-ref-name>
		<res-type>javax.sql.DataSource</res-type>
		<res-auth>Container</res-auth>
	</resource-ref>
	<resource-ref>
		<res-ref-name>jdbc/BHAE_EHARS_DS_ONE</res-ref-name>
		<res-type>javax.sql.DataSource</res-type>
		<res-auth>Container</res-auth>
	</resource-ref>
</web-app>
