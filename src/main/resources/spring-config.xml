	<bean id="prfReviewStatusCronTrigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail" ref="runPrfReviewStatusLoaderJob" />
		<property name="cronExpression" value="0 00 07 ? * MON-FRI" />
	</bean>
	
	<bean id="hl7RecordsProcessCronTrigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail" ref="runHL7RecordsProcessLoaderJob" />
		<property name="cronExpression" value="0 30 19 ? * SUN-FRI" />
	</bean>
	
