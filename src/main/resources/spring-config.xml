	    <property name="sqlSessionFactoryBeanName" value="sqlSessionFactory"/>
	</bean>	
	
	<bean id="MapperScannerConfigurer2" class="org.mybatis.spring.mapper.MapperScannerConfigurer">
        <property name="basePackage" value="gov.ny.state.doh.bhae.nyehms.schedulers.spring.dao.ecrls"/>
        <property name="sqlSessionFactoryBeanName" value="elrlsSessionFactory"/>
    </bean>
    
    
	<bean id="MapperScannerConfigurer3" class="org.mybatis.spring.mapper.MapperScannerConfigurer">
        <property name="basePackage" value="gov.ny.state.doh.bhae.nyehms.schedulers.spring.dao.ursdb"/>
        <property name="sqlSessionFactoryBeanName" value="ursSessionFactory"/>
    </bean>
    
	<!--  Spring Transaction Management Start-->
	<bean id="transactionManager"
