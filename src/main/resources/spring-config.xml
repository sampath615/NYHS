	<bean id="sqlSessionFactory" class="org.mybatis.spring.SqlSessionFactoryBean">
		<property name="dataSource" ref="appDS" />
		<property name="typeAliasesPackage"
			value="gov.ny.state.doh.bhae.nyehms.web.spring.domain" />
	</bean>
	
