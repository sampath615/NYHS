		<property name="jobDetail" ref="runDocumentFileReminderLoaderJob" />
		<property name="cronExpression" value="0 05 10 ? * MON-SUN" />
	</bean>

<!-- 	 	Moving Raw to Std and calls the Quality stage process  -->
	<bean id="cronTrigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">

		<property name="jobDetail" ref="runRawRecordsCleanerJob" />
		<property name="cronExpression" value="0 26 18 ? * SUN-THU" />

	</bean>
	
<!-- 	 	 Loads the Quality stage match results  -->
	<bean id="qsCronTrigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail" ref="runQualityStageLoaderJob" />
		<property name="cronExpression" value="0 56 23 ? * SUN-THU" />
	</bean>
	
	<bean id="bothQsMatchResultsTrigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">

		<property name="jobDetail" ref="runQualityStageMatchResultsLoaderForBothJobs" />
		<property name="cronExpression" value="0 00 02 ? * MON-FRI" />

	</bean>	
	
	<bean id="hitMessageCountStatusCronTrigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail" ref="runHITMessageCountLoader" />
		<property name="cronExpression" value="0 00 08 ? * MON-SUN" />
    </bean>
    
    <bean id="eharsDataLoaderCronTrigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail" ref="runEharsDataLoader" />
		<property name="cronExpression" value="0 15 03 ? * MON-SUN" />
    </bean>
    
    
    <bean id="weeklyDocumentStatusLoaderCronTrigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail" ref="runWeeklyDocumentStatusLoader" />
		<property name="cronExpression" value="0 30 10 ? * MON" />
    </bean>
    
    <bean id="monthlyDocumentStatusLoaderCronTrigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean">
		<property name="jobDetail" ref="runMonthlyDocumentStatusLoader" />
		<property name="cronExpression" value="0 30 09 01 1/1 ? *" />
    </bean>
    
    
    
    <bean name="schedulerFactoryBean" class="org.springframework.scheduling.quartz.SchedulerFactoryBean">
		
		<property name = "jobDetails">
			<list>
				<ref bean="runCCDLoaderJob"></ref>
			</list>
		</property>
		
		<property name="triggers">
			<list>
				<ref bean="cronTrigger" />
				<ref bean="qsCronTrigger" />
				<ref bean="prfReviewStatusCronTrigger" />
				<ref bean="hl7RecordsProcessCronTrigger" />
				<ref bean="documentFileReminderCronTrigger" />
				<ref bean="nyehmsLoginReminderCronTrigger" />
				<ref bean="nyehmsTrainingReminderCronTrigger" />
				<ref bean="bothQsMatchResultsTrigger" />
				<ref bean="hitMessageCountStatusCronTrigger" />
				<ref bean="eharsDataLoaderCronTrigger" />
				<ref bean="weeklyDocumentStatusLoaderCronTrigger" />
				<ref bean="monthlyDocumentStatusLoaderCronTrigger" />
			</list>
		</property>
	</bean>


	<!-- uploads are parsed by the servlet container; size limits are in web.xml <multipart-config> -->
	<bean id="multipartResolver"
		class="org.springframework.web.multipart.support.StandardServletMultipartResolver" />
</beans>