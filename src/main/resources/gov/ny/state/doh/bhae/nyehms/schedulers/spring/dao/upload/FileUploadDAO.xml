	<select id="getDemographicByFirstResistance" parameterType="String" resultType="gov.ny.state.doh.bhae.nyehms.web.spring.domain.document.ClusterDocVO">
		<![CDATA[
		WITH data AS
		(
		    SELECT /*+ parallel(a,6) */ c.stateno, a.document_id, a.fname, a.mname, a.lname, a.dob_text, b.received_date
		            , ROW_NUMBER() OVER (PARTITION BY c.stateno ORDER BY b.received_date) recd_order 
		      FROM document_locator b, person_doc_association c, std_hiv_eclrs_doc a
		     WHERE b.document_type_code = 'HIV_LAB'
		       AND b.test_type_cd = 'RESISTANCE'
		       AND b.is_active = 'Y'
		       AND b.document_id = a.document_id
		       AND c.stateno = #{stateno}
		       AND a.document_id = c.document_id
		       AND c.dissassociation_date IS NULL
		)
		SELECT document_id DOCUMENT_ID, stateno CURRENT_NYEHMS_STATENO, fname FIRST_NAME, mname MIDDLE_NAME, lname LAST_NAME, FN_TO_DATE(dob_text,'MM/DD/YYYY') as DOB, 'RESISTANCE' DEMO_DATA_SOURCE
		  FROM data
		WHERE recd_order = 1
		]]>
	</select>		    
	    
