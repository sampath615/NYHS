<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="gov.ny.state.doh.bhae.nyehms.web.spring.dao.standardization.provider.SubProviderDAO">


  
  
  
    <select id="addNewProvider" parameterType="java.util.Map"  statementType="CALLABLE" >
		{call PKG_STANDARDIZATION.pr_add_provider_name(
		    #{p_provider_fname,jdbcType=VARCHAR,mode=IN},
			#{p_provider_mname,jdbcType=VARCHAR,mode=IN},
			#{p_provider_lname,jdbcType=VARCHAR,mode=IN},
			#{p_provider_suffix,jdbcType=VARCHAR,mode=IN},
			#{p_worker_id,jdbcType=VARCHAR,mode=IN},
			#{p_provider_id_out,javaType=LONG,jdbcType=NUMERIC,mode=OUT},
			#{p_code_out,jdbcType=INTEGER,mode=OUT},
			#{p_msg_out,jdbcType=VARCHAR,mode=OUT}
		)}
	</select>
	
	<select id="getActiveProviders" resultMap="activeProviderDetails" parameterType="String">
		select PROVIDER_ID, PROVIDER_FULLNAME from nyehms_provider_names_list_vw where PROVIDER_FNAME like #{providerName} or PROVIDER_LNAME like #{providerName} 
	</select>
	
  	<resultMap type="java.util.Map" id="activeProviderDetails"> 	
 	  	<result property="value"  column="PROVIDER_ID"  jdbcType="VARCHAR" javaType="String"/>
		<result property="label" column="PROVIDER_FULLNAME" jdbcType="VARCHAR" javaType="String"/>
 	</resultMap>
 	
	 <update id="unableStandardizeRawProviderRecord" parameterType="java.util.Map">
		update RAW_PROVIDER_ADDRESS set SUB_PROVIDER_ADDRESS_ID  = 0, LAST_UPDATED_DATE = SYSDATE, LAST_UPDATED_BY = #{userId}  where RAW_PROVIDER_ADDRESS_ID = #{recordId} 
	</update>
	
	<update id="unableStandardizeProviderAddressRecord" parameterType="java.util.Map">
		update SUB_PROVIDER_ADDRESS set PROVIDER_ID  = 0, LAST_UPDATED_DATE = SYSDATE, LAST_UPDATED_BY = #{userId}  where SUB_PROVIDER_ADDRESS_ID = #{recordId} 
	</update>
</mapper>