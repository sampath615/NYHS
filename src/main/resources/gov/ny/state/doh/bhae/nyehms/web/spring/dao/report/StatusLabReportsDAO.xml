<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="gov.ny.state.doh.bhae.nyehms.web.spring.dao.report.StatusLabReportsDAO">



	<select id="getLabReportCount" resultMap="labReportsCountMap" parameterType="java.util.Map">
		${SQL_QUERY}
	</select>
	
	
	<resultMap type="gov.ny.state.doh.bhae.nyehms.web.spring.domain.lab.LabReportsCountVO" id="labReportsCountMap" > 
		
	 	<result column="DATASET" property="dataSet"   jdbcType="DECIMAL" javaType="Integer"/>
	 	<result column="WEEK_START_DT" property="weekStartDate"   jdbcType="VARCHAR" javaType="String"/>
	 	<result column="WEEK_END_DT" property="weekEndDate"   jdbcType="VARCHAR" javaType="String"/>
	 	<result column="REPORT_TEST_NAME" property="reportTestType"   jdbcType="VARCHAR" javaType="String"/>
	 	<result column="WEEK_NO" property="weekNumber"   jdbcType="DECIMAL" javaType="Integer"/>
	 	<result column="CNT" property="count"   jdbcType="DECIMAL" javaType="Integer"/>
	 	<result column="PERCENTAGE" property="percentage"   jdbcType="DECIMAL" javaType="Float"/>
 	</resultMap>    	
	
	<select id="monthlyLoincTestReport" parameterType="java.util.Map" statementType="CALLABLE">
		{call monthly_loinc_test_report (
			
			#{loincReportData,jdbcType=CURSOR, mode=OUT, javaType=java.sql.ResultSet, resultMap=monthlyReportData}
		)}
	</select>
	
	<resultMap type="java.util.Map" id="monthlyReportData">
	
	
	</resultMap>
	
	<select id="monthlyLabReportByRegion" parameterType="java.util.Map" statementType="CALLABLE">
		{call monthly_labs_by_region_report (
			
			#{loincReportData,jdbcType=CURSOR, mode=OUT, javaType=java.sql.ResultSet, resultMap=monthlyReportData}
		)}
	</select>
	
	
	
	    	
</mapper>

