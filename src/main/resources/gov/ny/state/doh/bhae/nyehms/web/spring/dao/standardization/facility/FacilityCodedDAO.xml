<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="gov.ny.state.doh.bhae.nyehms.web.spring.dao.standardization.facility.FacilityCodedDAO">

  	<resultMap type="java.util.Map" id="facilityTypeCode"> 	
 	  	<result property="code" column="FACILITY_TYPE_CODE" jdbcType="VARCHAR" javaType="String"/>
		<result property="desc" column="FACILITY_TYPE_DESCRIPTION" jdbcType="VARCHAR" javaType="String"/>
 	</resultMap>
	<select id="getFacilityTypeCodes" resultMap="facilityTypeCode">
		SELECT   FACILITY_TYPE_CODE, FACILITY_TYPE_DESCRIPTION 
		FROM     CODED_EHARS_FACILITY WHERE END_DATE IS NULL OR END_DATE > SYSDATE
		ORDER BY SORT_ORDER
	</select> 
  
</mapper>