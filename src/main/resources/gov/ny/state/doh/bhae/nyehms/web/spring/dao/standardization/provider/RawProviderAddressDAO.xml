<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="gov.ny.state.doh.bhae.nyehms.web.spring.dao.standardization.provider.RawProviderAddressDAO">

   <resultMap id="rawProvAddrssResult" type="gov.ny.state.doh.bhae.nyehms.web.spring.domain.standardization.provider.RawProviderAddressVO" >
    <id column="RAW_PROVIDER_ADDRESS_ID" property="rawProviderAddressId" jdbcType="DECIMAL" />
    <result column="SUB_PROVIDER_ADDRESS_ID" property="subProviderAddressId" jdbcType="DECIMAL" />
    <result column="COUNTY_FIPS" property="countyFips" jdbcType="VARCHAR" />
    <result column="ADDRESS" property="address" jdbcType="VARCHAR" />
    <result column="CITY" property="city" jdbcType="VARCHAR" />
    <result column="STATE" property="state" jdbcType="VARCHAR" />
    <result column="ZIPCODE" property="zipcode" jdbcType="VARCHAR" />
    <result column="PLUS4" property="plus4" jdbcType="VARCHAR" />
    <result column="PHONE" property="phone" jdbcType="VARCHAR" />
    <result column="NPI" property="rawProviderNPI" jdbcType="VARCHAR" />
    <result column="PROVIDER_FNAME" property="rawProviderFname" jdbcType="VARCHAR" />
    <result column="PROVIDER_MNAME" property="rawProviderMname" jdbcType="VARCHAR" />
    <result column="PROVIDER_LNAME" property="rawProviderLname" jdbcType="VARCHAR" />
    <result column="PROVIDER_SUFFIX" property="rawProviderSuffix" jdbcType="VARCHAR" />
    <result column="PROVIDER_FULLNAME" property="rawProviderFullName" jdbcType="VARCHAR" />
    <result column="AUTO_ASSIGN_FUTURE" property="autoAssignFuture" jdbcType="VARCHAR" />
  </resultMap>
  
  
  
  <select id="getRawProvAddrsList" resultType="gov.ny.state.doh.bhae.nyehms.web.spring.domain.standardization.provider.RawProviderAddressVO" parameterType="java.util.Map">
  
    SELECT RAW_PROVIDER_ADDRESS_ID rawProviderAddressId, COUNTY_FIPS countyFips, ADDRESS address, CITY city, STATE state, 
    	   ZIPCODE zipcode, PLUS4 plus4, NPI rawProviderNPI, PHONE phone, PROVIDER_FULLNAME rawProviderFullName, PROVIDER_FNAME rawProviderFname, PROVIDER_MNAME rawProviderMname, PROVIDER_LNAME rawProviderLname, PROVIDER_SUFFIX rawProviderSuffix
     FROM NYEHMS_RAW_PROVS_NO_MATCH_VW 
     		<choose>
			    <when test="_search == true">
			    	<trim prefix="where" >
			    		<choose>
						    <when test="searchField == 'rawProviderFullName'">
						    	UPPER(PROVIDER_FULLNAME)
			  		    	</when>
			  		    	<when test="searchField == 'address'">
						    	UPPER(ADDRESS) 
			  		    	</when>
			  		    	<when test="searchField == 'city'">
						    	UPPER(CITY) 
			  		    	</when>
			  		    	<when test="searchField == 'state'">
						    	UPPER(STATE) 
			  		    	</when>
			  		    	<when test="searchField == 'zipcode'">
						    	UPPER(ZIPCODE) 
			  		    	</when>
			  		    	<when test="searchField == 'phone'">
						    	UPPER(PHONE) 
			  		    	</when>
			  		    	<otherwise>
							   
						    </otherwise>
						  </choose>
						  
						  	<choose>
						    <when test="searchOper == 'eq'">
						    <![CDATA[
						      = UPPER(#{searchString})
						      ]]>   
						    </when>
						    <when test="searchOper == 'ne'">
						    <![CDATA[
						      != UPPER(#{searchString})
						      ]]>   
						    </when>
						    <when test="searchOper == 'bw'">
						    <![CDATA[
						      like UPPER(#{searchString}) || '%'
						      ]]>   
						    </when>
						    <when test="searchOper == 'bn'">
						    <![CDATA[
						      not like UPPER(#{searchString}) || '%'
						      ]]>   
						    </when>
						    <when test="searchOper == 'ew'">
						    <![CDATA[
						       like '%' || UPPER(#{searchString}) 
						       ]]>   
						    </when>
						    <when test="searchOper == 'en'">
						    <![CDATA[
						      not like '%' || UPPER(#{searchString})
						      ]]>   
						    </when>
						    <when test="searchOper == 'cn'">
						    <![CDATA[
						      like '%' || UPPER(#{searchString}) || '%'
						      ]]>   
						    </when>
						    <when test="searchOper == 'nc'">
						    <![CDATA[
						      not like '%' || UPPER(#{searchString}) || '%'
						      ]]>   
						    </when>
						    <when test="searchOper == 'in'">
						    	 in <foreach item="parameter" index="index" collection="searchString"
							            open="(" separator="," close=")">
							            UPPER(#{parameter})
							        </foreach>
						    </when>
						    <when test="searchOper == 'ni'">
						    
						      not in  	  
						   			<foreach item="parameter" index="index" collection="searchString"
							            open="(" separator="," close=")">
							            UPPER(#{parameter})
							        </foreach>
							</when>
						    <otherwise>
						    <![CDATA[
						      ROWNUM <= 100
						      ]]>  
						    </otherwise>
						  </choose>
						 </trim>
			    </when>
			    <otherwise>
				    <![CDATA[
	     					where  ROWNUM <= 100   
	     			]]>    
			    </otherwise>
			  </choose>
  </select>
  
  <select id="linkRawProvToSubProvAddrs" parameterType="java.util.Map" statementType="CALLABLE">
		{call PKG_STANDARDIZATION.pr_link_raw_sub_provider(
			#{p_raw_provider_address_id,jdbcType=INTEGER,mode=IN},
			#{p_sub_provider_address_id,jdbcType=INTEGER,mode=IN},
			#{p_worker_id,jdbcType=INTEGER,mode=IN},
			#{p_code_out,jdbcType=INTEGER,mode=OUT},
			#{p_msg_out,jdbcType=VARCHAR,mode=OUT}
		)}
		
	</select>
	
	<select id="getRawProvAdrsIdsForSearch" parameterType="gov.ny.state.doh.bhae.nyehms.web.spring.domain.standardization.provider.RawProviderAddressVO"  resultType="Long">
    select 
			RAW_PROVIDER_ADDRESS_ID
    from    RAW_PROVIDER_ADDRESS
	where    <trim prefix="" suffix="" prefixOverrides="AND" >
	              <if test="rawProviderFname != null and rawProviderFname != ''" >
			        AND UPPER(PROVIDER_FNAME) LIKE UPPER(#{providerFname,jdbcType=VARCHAR})  || '%' 
			      </if>
			      <if test="rawProviderMname != null and rawProviderMname !=''" >
			        AND UPPER(PROVIDER_MNAME) LIKE UPPER(#{providerMname,jdbcType=VARCHAR})  || '%' 
			      </if>
			      <if test="rawProviderLname != null and rawProviderLname !=''" >
			        AND UPPER(PROVIDER_LNAME) LIKE UPPER(#{providerLname,jdbcType=VARCHAR})  || '%' 
			      </if>
			      <if test="address != null and address != ''" >
			        AND UPPER(ADDRESS) LIKE UPPER(#{address,jdbcType=VARCHAR})  || '%' 
			      </if>
			      <if test="city != null and city != ''" >
			        AND UPPER(CITY) LIKE UPPER(#{city,jdbcType=VARCHAR})  || '%' 
			      </if>
			      <if test="state != null and state != ''" >
			        AND UPPER(STATE) LIKE UPPER(#{state,jdbcType=VARCHAR})  || '%' 
			      </if>
			      <if test="zipcode != null and  zipcode != ''" >
			        AND ZIPCODE LIKE #{zipcode,jdbcType=VARCHAR}  || '%' 
			      </if>
			       <if test="countyFips != null and countyFips != ''" >
		            AND COUNTY_FIPS LIKE #{countyFips,jdbcType=VARCHAR}  || '%' 
		           </if>
			       <if test="phone != null and phone != ''" >
			        AND PHONE LIKE #{phone,jdbcType=VARCHAR}  || '%' 
			      </if>
			</trim>       
  </select>
  
   <select id="getRawProvAdrsListBySubprovAdrsId" parameterType="java.util.Map"  statementType="CALLABLE">
	   {CALL PKG_STANDARDIZATION.PR_RAW_PROV_ADDRESSES_BY_SUB(
	   		#{subProviderAdrsId,jdbcType=BIGINT,mode=IN},
			#{rawSubProvIds,jdbcType=VARCHAR,mode=IN},
			#{rawProvAdrsListRefCursor,jdbcType=CURSOR, mode=OUT, javaType=java.sql.ResultSet, resultMap=rawProvAddrssResult}
		)}
  </select>
  <select id="flagProviderDataAsFacilty" parameterType="java.util.Map"  statementType="CALLABLE">
	   {CALL PKG_STANDARDIZATION.pr_flip_to_facility (
	      #{providerId,jdbcType=BIGINT,mode=IN},
	      #{workerId,jdbcType=BIGINT,mode=IN},
	      #{statusCode,jdbcType=INTEGER,mode=OUT},
	      #{statusMessage,jdbcType=VARCHAR,mode=OUT}
		)}
  </select>
  
    <select id="getRawProvAddrsNewList" resultType="gov.ny.state.doh.bhae.nyehms.web.spring.domain.standardization.provider.RawProviderAddressVO" parameterType="java.util.Map">
  
    SELECT RAW_PROVIDER_ADDRESS_ID rawProviderAddressId, ADDRESS address, CITY city, STATE state, 
    	   ZIPCODE zipcode, PLUS4 plus4, NPI rawProviderNPI, PHONE phone, PROVIDER_FULLNAME rawProviderFullName, PROVIDER_FNAME rawProviderFname, PROVIDER_MNAME rawProviderMname, PROVIDER_LNAME rawProviderLname
     FROM NYEHMS_RAW_PROVS_NO_MATCH_NEW_VW 
     		<choose>
			    <when test="selected == true">
				    <![CDATA[
	     				where  SUB_PROVIDER_ADDRESS_ID = -9999 and RAW_PROVIDER_ADDRESS_ID in
	     			]]> 
   						<foreach item="selectedId" index="index" collection="selectedIds" open="(" separator="," close=")">
			        		#{selectedId}
			  		 	</foreach>
			    </when>
			    <otherwise>
				    <![CDATA[
	     					where  ROWNUM <= 1000   
	     			]]>    
			    </otherwise>
			</choose>
  </select>
  
  <select id="linkRawProvAddressesToSubProvAddrs" parameterType="java.util.Map" statementType="CALLABLE">
		{call PKG_STANDARDIZATION.pr_link_raw_sub_provider_mult(
			#{p_raw_provider_addr_id_list,jdbcType=VARCHAR,mode=IN},
			#{p_sub_provider_address_id,jdbcType=INTEGER,mode=IN},
			#{p_worker_id,jdbcType=INTEGER,mode=IN},
			#{p_code_out,jdbcType=INTEGER,mode=OUT},
			#{p_msg_out,jdbcType=VARCHAR,mode=OUT}
		)}
		
	</select>
	
  <select id="flagSelectedRawProviderAsFacilty" parameterType="java.util.Map"  statementType="CALLABLE">
	   {CALL PKG_STANDARDIZATION.pr_flip_to_facility_Multiple (
	      #{p_raw_provider_addr_id_list,jdbcType=VARCHAR,mode=IN},
	      #{p_user_id,jdbcType=BIGINT,mode=IN},
	      #{p_code_out,jdbcType=INTEGER,mode=OUT},
	      #{p_msg_out,jdbcType=VARCHAR,mode=OUT}
		)}
  </select>
  
  <select id="getMasterProvRecords" resultType="org.json.simple.JSONObject">
  	select RAW_PROVIDER_ADDRESS_ID "value", PROVIDER_LNAME ||', ' || PROVIDER_FNAME "label" from raw_provider_address where MASTER_PROV = 'Y'
  </select>
  	  
  	  
  <select id="getMasterProvData" parameterType="String" resultType="org.json.simple.JSONObject">
  	select PROVIDER_FNAME, PROVIDER_MNAME, PROVIDER_LNAME, PROVIDER_SUFFIX, ADDRESS, city, state, COUNTY_FIPS,
  	
  	case when length(substr(regexp_replace(zipcode, '\D'),0, 5)) = 5 then substr(regexp_replace(zipcode , '\D'),0, 5) else null end  zipcode,
  	case when length(substr(regexp_replace(phone, '\D'),0, 10)) = 10 then substr(regexp_replace(phone, '\D'),0, 10) else null end  phone , 
  	
  	NPI  from raw_provider_address where raw_provider_address_id = #{providerId}
  </select>
</mapper>