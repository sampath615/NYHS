<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="gov.ny.state.doh.bhae.nyehms.web.spring.dao.report.SearchHistoryDAO">
	
	<select id="getSearchedWorkerNames" resultType="org.json.simple.JSONObject">
		SELECT distinct b.worker_id, pkg_trk_common.fn_get_fullname (b.last_name,
		                                       b.first_name,
		                                       b.middle_name,
		                                       NULL) worker_name
		  FROM nyehms_search_history a
		  JOIN nyehms_users b ON b.worker_id = a.worker_id
		ORDER BY worker_name
	</select>
	
  	<resultMap type="org.json.simple.JSONObject" id="searchHistoryReportData"></resultMap>
  	 
  	<select id="getSearchHistoryReportData" parameterType="java.util.Map" statementType="CALLABLE">
		{call pr_get_search_history(
			#{p_from_date,jdbcType=VARCHAR,mode=IN},
			#{p_to_date,jdbcType=VARCHAR,mode=IN},
			#{p_worker_id,jdbcType=INTEGER,mode=IN},
			#{p_request_worker_id,jdbcType=INTEGER,mode=IN},
			#{p_search_history,jdbcType=CURSOR, mode=OUT, javaType=java.sql.ResultSet, resultMap=searchHistoryReportData}
		)}  
  	</select>	
	
</mapper>	