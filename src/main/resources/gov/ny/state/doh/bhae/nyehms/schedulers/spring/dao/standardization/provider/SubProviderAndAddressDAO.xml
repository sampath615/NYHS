<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="gov.ny.state.doh.bhae.nyehms.web.spring.dao.standardization.provider.SubProviderAndAddressDAO">

   <resultMap id="getSubProvAddrssResult" type="gov.ny.state.doh.bhae.nyehms.web.spring.domain.standardization.provider.SubProviderAndAddressVO" >
    <id     column="SUB_PROVIDER_ADDRESS_ID" property="subProviderAddressId" jdbcType="DECIMAL" />
    <result column="PROVIDER_ID" property="providerId" jdbcType="DECIMAL" />
    <result column="COUNTY_FIPS" property="countyFips" jdbcType="VARCHAR" />
    <result column="ADDRESS" property="address" jdbcType="VARCHAR" />
    <result column="CITY" property="city" jdbcType="VARCHAR" />
    <result column="STATE" property="state" jdbcType="VARCHAR" />
    <result column="ZIPCODE" property="zipcode" jdbcType="VARCHAR" />
    <result column="PLUS4" property="plus4" jdbcType="VARCHAR" />
    <result column="PHONE" property="phone" jdbcType="VARCHAR" />
    <result column="NPI"  property="providerNPI"  jdbcType="VARCHAR" />
    <result column="PROVIDER_FNAME"  property="providerFname"  jdbcType="VARCHAR" />
    <result column="PROVIDER_MNAME"  property="providerMname"  jdbcType="VARCHAR" />
    <result column="PROVIDER_LNAME"  property="providerLname"  jdbcType="VARCHAR" />
    <result column="PROVIDER_SUFFIX" property="providerSuffix" jdbcType="VARCHAR" />
    <result column="ADDRESS_COUNT" property="totalSubProviderAddress" jdbcType="VARCHAR" />
  </resultMap>
  
  <select id="getSrchSubProvAddressList" parameterType="java.util.Map"  statementType="CALLABLE">
   {call PKG_STANDARDIZATION.pr_sub_provider_search (
		 #{p_provider_fname,jdbcType=VARCHAR,mode=IN},
			#{p_provider_lname,jdbcType=VARCHAR,mode=IN},
			#{p_provider_mname,jdbcType=VARCHAR,mode=IN},
			#{p_address,jdbcType=VARCHAR,mode=IN},
			#{p_city,jdbcType=VARCHAR,mode=IN},
			#{p_state,jdbcType=VARCHAR,mode=IN},
			#{p_zipcode,jdbcType=VARCHAR,mode=IN},
			#{p_county_fips,jdbcType=VARCHAR,mode=IN},
			#{p_phone,jdbcType=VARCHAR,mode=IN},
			#{p_sub_prov_out,jdbcType=CURSOR, mode=OUT, javaType=java.sql.ResultSet, resultMap=getSubProvAddrssResult}
		)}
		    	     
  </select>
  
  <select id="getProvAddressListByProvId" parameterType="gov.ny.state.doh.bhae.nyehms.web.spring.domain.standardization.provider.SubProviderAndAddressVO" resultMap="getSubProvAddrssResult" >
    SELECT PROVIDER_ID, SUB_PROVIDER_ADDRESS_ID, COUNTY_FIPS, ADDRESS, CITY, STATE, 
    	   ZIPCODE, PLUS4, PHONE    
    FROM   SUB_PROVIDER_ADDRESS 
    WHERE  <trim prefix="" suffix="" prefixOverrides="AND" >
			      <if test="providerId != 0 and providerId != ''" >
			        AND PROVIDER_ID LIKE #{providerId,jdbcType=DECIMAL}  || '%' 
			      </if>
			      <if test="address != null and address != ''" >
			        AND UPPER(ADDRESS) LIKE UPPER(#{address,jdbcType=VARCHAR})  || '%'  
			      </if>
			      <if test="city != null and city != ''" >
			        AND UPPER(CITY) LIKE UPPER(#{city,jdbcType=VARCHAR})  || '%' 
			      </if>
			      <if test="state != null and state != ''" >
			        AND UPPER(STATE) LIKE UPPER(#{state,jdbcType=VARCHAR}) || '%' 
			      </if>
			      <if test="zipcode != null and  zipcode != ''" >
			        AND ZIPCODE LIKE #{zipcode,jdbcType=VARCHAR}  || '%' 
			      </if>
			       <if test="phone != null and phone != ''" >
			        AND PHONE LIKE #{phone,jdbcType=VARCHAR}  || '%' 
			      </if>
		    </trim>
    
  </select>
  
  <select id="addNewSubProvAddrs" parameterType="java.util.Map"  statementType="CALLABLE" >
		{call PKG_STANDARDIZATION.pr_add_sub_provider(
		    #{p_provider_fname,jdbcType=VARCHAR,mode=IN},
			#{p_provider_mname,jdbcType=VARCHAR,mode=IN},
			#{p_provider_lname,jdbcType=VARCHAR,mode=IN},
			#{p_provider_suffix,jdbcType=VARCHAR,mode=IN},
			#{p_county_fips,jdbcType=VARCHAR,mode=IN},
			#{p_address,jdbcType=VARCHAR,mode=IN},
			#{p_city,jdbcType=VARCHAR,mode=IN},
			#{p_state,jdbcType=VARCHAR,mode=IN},
			#{p_zipcode,jdbcType=VARCHAR,mode=IN},
			#{p_plus4, jdbcType=VARCHAR,mode=IN},
			#{p_phone,jdbcType=VARCHAR,mode=IN},
			#{p_extension,jdbcType=VARCHAR,mode=IN},
			#{p_worker_id,jdbcType=VARCHAR,mode=IN},
			#{p_npi,jdbcType=VARCHAR,mode=IN},
			#{p_sub_provider_id_out,javaType=LONG,jdbcType=NUMERIC,mode=OUT},
			#{p_sub_provider_address_id_out,javaType=LONG,jdbcType=NUMERIC,mode=OUT},
			#{p_code_out,jdbcType=INTEGER,mode=OUT},
			#{p_msg_out,jdbcType=VARCHAR,mode=OUT},
			#{p_speciality,jdbcType=VARCHAR,mode=IN}
		)}
	</select>
	
		<insert id="createRawProviderAddress" parameterType="java.util.Map" useGeneratedKeys="true" keyColumn="RAW_PROVIDER_ADDRESS_ID" keyProperty="rawProviderId">
		insert into RAW_PROVIDER_ADDRESS(RAW_PROVIDER_ADDRESS_ID, SUB_PROVIDER_ADDRESS_ID, COUNTY_FIPS, ADDRESS, CITY, STATE, PLUS4, ZIPCODE, PHONE, PROVIDER_FNAME, PROVIDER_MNAME, PROVIDER_LNAME, PROVIDER_SUFFIX, NPI) 
                values(RAW_PROVIDER_ADDRESS_SEQ.NEXTVAL, #{p_subprovideraddress_id}, #{p_county_fips,jdbcType=VARCHAR}, #{p_address,jdbcType=VARCHAR}, #{p_city,jdbcType=VARCHAR}, #{p_state,jdbcType=VARCHAR}, #{p_plus4,jdbcType=VARCHAR}, #{p_zipcode,jdbcType=VARCHAR},  #{p_phone,jdbcType=VARCHAR}, #{p_provider_fname,jdbcType=VARCHAR}, #{p_provider_mname,jdbcType=VARCHAR}, #{p_provider_lname,jdbcType=VARCHAR}, #{p_provider_suffix,jdbcType=VARCHAR}, #{p_npi,jdbcType=VARCHAR})
	</insert>
	
	 <select id="checkRawProviderAddressExistance" parameterType="gov.ny.state.doh.bhae.nyehms.web.spring.domain.standardization.provider.SubProviderAndAddressVO" resultType="int" >
	 	select NVL(MAX(RAW_PROVIDER_ADDRESS_ID),0) from RAW_PROVIDER_ADDRESS where 
	 	
	 		<choose>
			    <when test="address != null and address != ''">
			    <![CDATA[
			      ADDRESS = #{address}
			      ]]>   
			    </when>
			    <otherwise>
			    ADDRESS is null
			    </otherwise>
			</choose>
			
			<choose>
			    <when test="city != null and city != ''">
			    <![CDATA[
			      and CITY = #{city}
			      ]]>   
			    </when>
			    <otherwise>
			    and CITY is null
			    </otherwise>
			</choose>
			
			<choose>
			    <when test="state != null and state != ''">
			    <![CDATA[
			      and STATE = #{state}
			      ]]>   
			    </when>
			    <otherwise>
			    and STATE is null
			    </otherwise>
			</choose>
			
			<choose>
			    <when test="zipcode != null and zipcode != ''">
			    <![CDATA[
			      and ZIPCODE = #{zipcode}
			      ]]>   
			    </when>
			    <otherwise>
			   and  ZIPCODE is null
			    </otherwise>
			</choose>
			
			<choose>
			    <when test="phone != null and phone != ''">
			    <![CDATA[
			      and PHONE = #{phone}
			      ]]>   
			    </when>
			    <otherwise>
			    and PHONE is null
			    </otherwise>
			</choose>
			
			<choose>
			    <when test="countyFips != null and countyFips != ''">
			    <![CDATA[
			      and COUNTY_FIPS = #{countyFips}
			      ]]>   
			    </when>
			    <otherwise>
			    and COUNTY_FIPS is null
			    </otherwise>
			</choose>
			
			<choose>
			    <when test="providerFname != null and providerFname != ''">
			    <![CDATA[
			      and PROVIDER_FNAME = #{providerFname}
			      ]]>   
			    </when>
			    <otherwise>
			    and PROVIDER_FNAME is null
			    </otherwise>
			</choose>
			
			<choose>
			    <when test="providerMname != null and providerMname != ''">
			    <![CDATA[
			      and PROVIDER_MNAME = #{providerMname}
			      ]]>   
			    </when>
			    <otherwise>
			    and PROVIDER_MNAME is null
			    </otherwise>
			</choose>
			
			<choose>
			    <when test="providerLname != null and providerLname != ''">
			    <![CDATA[
			      and PROVIDER_LNAME = #{providerLname}
			      ]]>   
			    </when>
			    <otherwise>
			    and PROVIDER_LNAME is null
			    </otherwise>
			</choose>
			
			<choose>
			    <when test="providerSuffix != null and providerSuffix != ''">
			    <![CDATA[
			      and PROVIDER_SUFFIX = #{providerSuffix}
			      ]]>   
			    </when>
			    <otherwise>
			    and PROVIDER_SUFFIX is null
			    </otherwise>
			</choose>
			
			<choose>
			    <when test="plus4 != null and plus4 != ''">
			    <![CDATA[
			      and PLUS4 = #{plus4}
			      ]]>   
			    </when>
			    <otherwise>
			    and PLUS4 is null
			    </otherwise>
			</choose>
			<![CDATA[
			       and rownum < 2
			      ]]>  
	 </select>
	
	
	
	<select id="addNewAddrs" parameterType="java.util.Map"  statementType="CALLABLE">
		{call PKG_STANDARDIZATION.pr_add_sub_provider_address(
		    #{p_provider_id,jdbcType=INTEGER,mode=IN},
			#{p_county_fips,jdbcType=VARCHAR,mode=IN},
			#{p_address,jdbcType=VARCHAR,mode=IN},
			#{p_city,jdbcType=VARCHAR,mode=IN},
			#{p_state,jdbcType=VARCHAR,mode=IN},
			#{p_zipcode,jdbcType=VARCHAR,mode=IN},
			#{p_plus4, jdbcType=VARCHAR,mode=IN},
			#{p_phone,jdbcType=VARCHAR,mode=IN},
			#{p_extension,jdbcType=VARCHAR,mode=IN},
			#{p_worker_id,jdbcType=VARCHAR,mode=IN},
			#{p_sub_provider_address_id_out,javaType=LONG,jdbcType=NUMERIC,mode=OUT},
			#{p_code_out,jdbcType=INTEGER,mode=OUT},
			#{p_msg_out,jdbcType=VARCHAR,mode=OUT}
		)}
		
	</select>
  
</mapper>