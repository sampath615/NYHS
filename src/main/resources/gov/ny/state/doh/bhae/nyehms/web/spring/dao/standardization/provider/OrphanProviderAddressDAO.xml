<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="gov.ny.state.doh.bhae.nyehms.web.spring.dao.standardization.provider.OrphanProviderAddressDAO">

   <resultMap id="orphanProviderAddresses" type="gov.ny.state.doh.bhae.nyehms.web.spring.domain.standardization.provider.SubProviderAddressVO" >
    <id     column="SUB_PROVIDER_ADDRESS_ID" property="subProviderAddressId" jdbcType="DECIMAL" />
    <result column="PROVIDER_ID"             property="providerId"           jdbcType="DECIMAL" />
    <result column="COUNTY_FIPS"             property="countyFips"           jdbcType="VARCHAR" />
    <result column="ADDRESS"                 property="address"              jdbcType="VARCHAR" />
    <result column="CITY"                    property="city"                 jdbcType="VARCHAR" />
    <result column="STATE"                   property="state"                jdbcType="VARCHAR" />
    <result column="ZIPCODE"                 property="zipcode"              jdbcType="VARCHAR" />
    <result column="PLUS4"                   property="plus4"                jdbcType="VARCHAR" />
    <collection ofType="String" column="SUB_PROVIDER_ADDRESS_ID" property="phone">
    	<result column="PHONE" property="phone" jdbcType="VARCHAR" />	    	
    </collection>
  </resultMap>
  
  <select id="getOrphanProviderAddresses" resultMap="orphanProviderAddresses">
SELECT SUB_PROVIDER_ADDRESS_ID,PROVIDER_ID,COUNTY_FIPS,ADDRESS,CITY,STATE,ZIPCODE,PLUS4,PHONE
FROM NYEHMS_PROV_ADDR_ORPHAN_VW 
 </select>
  
  <select id="linkOrphanAddressToProvider" parameterType="java.util.Map" statementType="CALLABLE">
		{call PKG_STANDARDIZATION.pr_link_sub_provider_addr_name(
			#{providerAddressId,jdbcType=INTEGER,mode=IN},
			#{providerId,jdbcType=INTEGER,mode=IN},
			#{workerId,jdbcType=INTEGER,mode=IN},
			#{statusCode,jdbcType=INTEGER,mode=OUT},
			#{statusMessage,jdbcType=VARCHAR,mode=OUT}
		)}
 </select>
</mapper>