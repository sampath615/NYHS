    <result column="MASTER_FACILITY_NAME"  property="masterFacilityName"  jdbcType="VARCHAR" />
    <collection ofType="gov.ny.state.doh.bhae.nyehms.web.spring.domain.standardization.facility.SubFacilityVO" column="MASTER_FACILITY_ID" property="subFacilities">
	    <id column="SUB_FACILITY_ID"  property="subFacilityId" jdbcType="DECIMAL" />
	    <result column="FACILITY_TYPE_CODE" property="facilityTypeCode" jdbcType="VARCHAR" />    	
	    <result column="FACILITY_NAME" property="facilityName" jdbcType="VARCHAR" />
	    <result column="FACILITY_DEPARTMENT" property="facilityDepartment" jdbcType="VARCHAR" />
	    <result column="COUNTY_FIPS" property="countyFips" jdbcType="VARCHAR" />  
