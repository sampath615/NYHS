<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="gov.ny.state.doh.bhae.nyehms.web.spring.dao.report.ProviderPortalReportDAO">
	
	<select id="getProvPortalSubmittedProviders" resultType="org.json.simple.JSONObject" parameterType="java.util.Map">

		select distinct PORTAL_PROV_ID, PROVIDER_FNAME || ' ' || PROVIDER_MNAME || ' ' || PROVIDER_LNAME  PROVIDER_NAME from PORTAL_PROVIDERS where PORTAL_PROV_ID in
		    ( select PORTAL_PROV_ID from PORTAL_PROVIDERS where PROVIDER_HCSID in (select distinct UPLOAD_UID from EPRF_PROV_PORTAL_FILE_UPLOAD where file_type in (#{fileType1},#{fileType2}))
		      union 
		      select PORTAL_PROV_ID  from PORTAL_PROVIDER_USER_MAPPING where USER_HCSID in (select distinct UPLOAD_UID from EPRF_PROV_PORTAL_FILE_UPLOAD where file_type in (#{fileType1},#{fileType2}))
		     )

	</select>	
		 
	<resultMap type="gov.ny.state.doh.bhae.nyehms.web.spring.domain.reports.ProvPortalSubmissionReportVO" id="provPortalSNPReport">
			<result property="file_type_cd" column="file_type_cd"   jdbcType="VARCHAR"/>
			<result property="upload_dt" column="upload_dt"   jdbcType="VARCHAR"/>
			<result property="provider_id" column="provider_id"   jdbcType="VARCHAR"/>			
			<result property="provider_name" column="provider_name"   jdbcType="VARCHAR"/>			
			<result property="upload_filename" column="upload_filename"   jdbcType="VARCHAR"/>
			<result property="persons_in_file" column="persons_in_file"   jdbcType="VARCHAR"/>
			<result property="matches_to_registry" column="matches_to_registry"   jdbcType="VARCHAR"/>
			<result property="non_matches" column="non_matches"   jdbcType="VARCHAR"/>
			<result property="conf_cases" column="conf_cases"   jdbcType="VARCHAR"/>
			<result property="not_conf_cases" column="not_conf_cases"   jdbcType="VARCHAR"/>
	</resultMap>	 
	
	<resultMap type="gov.ny.state.doh.bhae.nyehms.web.spring.domain.reports.ProvPortalSubmissionReportVO" id="provPortalOOCDNLTCReport">
			<result property="file_type_cd" column="file_type_cd"   jdbcType="VARCHAR"/>
			<result property="upload_dt" column="upload_dt"   jdbcType="VARCHAR"/>
			<result property="provider_id" column="provider_id"   jdbcType="VARCHAR"/>			
			<result property="provider_name" column="provider_name"   jdbcType="VARCHAR"/>			
			<result property="upload_filename" column="upload_filename"   jdbcType="VARCHAR"/>
			<result property="persons_in_file" column="persons_in_file"   jdbcType="VARCHAR"/>
			<result property="matches_to_registry" column="matches_to_registry"   jdbcType="VARCHAR"/>
			<result property="non_matches" column="non_matches"   jdbcType="VARCHAR"/>
			<result property="meets_case_def" column="meets_case_def"   jdbcType="VARCHAR"/>
			<result property="meets_eligibility" column="meets_eligibility"   jdbcType="VARCHAR"/>
	</resultMap>	 

	<resultMap type="gov.ny.state.doh.bhae.nyehms.web.spring.domain.reports.ProvPortalSubmissionCareStatusVO" id="provPortalOOCDNLTCCareStatus">
			<result property="file_type_cd" column="file_type_cd"   jdbcType="VARCHAR"/>
			<result property="upload_filename" column="upload_filename"   jdbcType="VARCHAR"/>
			<result property="no_confirmatory_results_reported" column="no_confirmatory_results_reported"   jdbcType="VARCHAR"/>
			<result property="not_a_provider_of_this_patient" column="not_a_provider_of_this_patient"   jdbcType="VARCHAR"/>
			<result property="deceased" column="deceased"   jdbcType="VARCHAR"/>
			<result property="current_residence_is_out_of_state" column="current_residence_is_out_of_state"   jdbcType="VARCHAR"/>
			<result property="in_care" column="in_care"   jdbcType="VARCHAR"/>
			<result property="diagnosed_never_linked_to_care" column="diagnosed_never_linked_to_care"   jdbcType="VARCHAR"/>
			<result property="out_of_care" column="out_of_care"   jdbcType="VARCHAR"/>
			<result property="none" column="none"   jdbcType="VARCHAR"/>
			<result property="totals" column="totals"   jdbcType="VARCHAR"/>
	</resultMap>
		 
	<resultMap type="gov.ny.state.doh.bhae.nyehms.web.spring.domain.reports.ProvPortalOocDnltcGttDataVO" id="provPortalOOCDNLTCGttData">
			<result property="file_type_cd" column="file_type_cd"   jdbcType="VARCHAR"/>
			<result property="upload_dt" column="upload_dt"   jdbcType="VARCHAR"/>
			<result property="provider_id" column="provider_id"   jdbcType="VARCHAR"/>
			<result property="provider_name" column="provider_name"   jdbcType="VARCHAR"/>
			<result property="upload_filename" column="upload_filename"   jdbcType="VARCHAR"/>
			<result property="stateno" column="stateno"   jdbcType="VARCHAR"/>
			<result property="document_id" column="document_id"   jdbcType="DECIMAL"/>			
			<result property="match_cd" column="match_cd"   jdbcType="VARCHAR"/>
			<result property="hiv_cdc" column="hiv_cdc"   jdbcType="VARCHAR"/>
			<result property="aids_cdc" column="aids_cdc"   jdbcType="VARCHAR"/>
			<result property="hiv_aids_cdc_elig" column="hiv_aids_cdc_elig"   jdbcType="VARCHAR"/>
			<result property="care_status" column="care_status"   jdbcType="VARCHAR"/>
			<result property="conclusion" column="conclusion"   jdbcType="VARCHAR"/>
	</resultMap>
		 
	<select id="getProvPortalReportData" parameterType="java.util.Map" statementType="CALLABLE">	
		{call pr_get_eprf_ooc_reports(
			#{p_file_type_cd,jdbcType=VARCHAR,mode=IN},
			#{p_prov_id,jdbcType=VARCHAR,mode=IN},			
			#{p_from_date,jdbcType=VARCHAR,mode=IN},
			#{p_to_date,jdbcType=VARCHAR,mode=IN},
			#{p_snp_report,jdbcType=CURSOR, mode=OUT, javaType=java.sql.ResultSet, resultMap=provPortalSNPReport},
 			#{p_ooc_dnltc_report,jdbcType=CURSOR, mode=OUT, javaType=java.sql.ResultSet, resultMap=provPortalOOCDNLTCReport},
			#{p_ooc_dnltc_care_status,jdbcType=CURSOR, mode=OUT, javaType=java.sql.ResultSet, resultMap=provPortalOOCDNLTCCareStatus},
			#{p_eprf_ooc_gtt_data,jdbcType=CURSOR, mode=OUT, javaType=java.sql.ResultSet, resultMap=provPortalOOCDNLTCGttData}
		)}  
	</select> 

</mapper>