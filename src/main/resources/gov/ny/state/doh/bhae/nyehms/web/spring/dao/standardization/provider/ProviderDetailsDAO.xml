   <select id="getRawProviderDetails" parameterType="java.util.Map"  resultType="gov.ny.state.doh.bhae.nyehms.web.spring.domain.standardization.provider.RawProviderAddressVO">
   
   select RAW_PROVIDER_ADDRESS_ID rawProviderAddressId, ADDRESS address, CITY city, STATE state, COUNTY_FIPS countyFips, ZIPCODE zipcode, PLUS4 plus4, PHONE phone, pkg_trk_common.fn_get_fullname (PROVIDER_LNAME,
                                            PROVIDER_FNAME,
                                            PROVIDER_MNAME,
                                            PROVIDER_SUFFIX)  rawProviderFullName, NPI rawProviderNPI from RAW_PROVIDER_ADDRESS
   
   <trim prefix="where" suffixOverrides="and">
   		<if test="p_provider_fname != null">
   			PROVIDER_FNAME like #{p_provider_fname} and 
   		</if>
   		<if test="p_provider_lname != null">
   			PROVIDER_LNAME like #{p_provider_lname} and 
   		</if>
   		<if test="p_provider_mname != null">
   			PROVIDER_MNAME like #{p_provider_mname} and 
   		</if>
   		<if test="p_address != null">
   			ADDRESS like #{p_address} and 
   		</if>
   		<if test="p_city != null">
   			CITY like #{p_city} and 
   		</if>
   		<if test="p_state != null">
   			STATE = #{p_state} and 
   		</if>
   		<if test="p_zipcode != null">
   			ZIPCODE like #{p_zipcode} and 
   		</if>
   		<if test="p_county_fips != null">
   			COUNTY_FIPS = #{p_county_fips} and 
   		</if>
   		<if test="p_phone != null">
   			PHONE like #{p_phone} and 
   		</if>
   		<if test="p_provider_npi != null">
   			NPI like #{p_provider_npi} and 
   		</if>
   
   </trim>
  </select>
  
  
  

	
	
