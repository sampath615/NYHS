<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="gov.ny.state.doh.bhae.nyehms.web.spring.dao.standardization.facility.OrphanSubFacilityDAO">

   <resultMap id="subFacility" type="gov.ny.state.doh.bhae.nyehms.web.spring.domain.standardization.facility.SubFacilityVO" >
	    <id column="SUB_FACILITY_ID"  property="subFacilityId" jdbcType="DECIMAL" />
	    <result column="FACILITY_TYPE_CODE" property="facilityTypeCode" jdbcType="VARCHAR" />
	    <result column="FACILITY_NAME" property="facilityName" jdbcType="VARCHAR" />
	    <result column="FACILITY_DEPARTMENT" property="facilityDepartment" jdbcType="VARCHAR" />  
	    <result column="ADDRESS" property="address" jdbcType="VARCHAR" />
	    <result column="CITY" property="city" jdbcType="VARCHAR" />
	    <result column="STATE" property="state" jdbcType="VARCHAR" />
	    <result column="ZIPCODE" property="zipcode" jdbcType="VARCHAR" />
	     <collection ofType="String" column="SUB_FACILITY_ID" property="phone">
    		<result column="PHONE" property="phone" jdbcType="VARCHAR" />	    	
    	</collection>
	</resultMap>  
  <select id="getOrphanSubFacilities" resultMap="subFacility">
SELECT SUB_FACILITY_ID,FACILITY_TYPE_CODE,FACILITY_NAME,FACILITY_DEPARTMENT,ADDRESS,CITY,STATE,ZIPCODE,PHONE
FROM NYEHMS_SUB_FACILITY_ORPHAN_VW 
</select>
  
  <select id="linkOrphanSubFacilityToMasterFacility" parameterType="java.util.Map" statementType="CALLABLE">
		{call PKG_STANDARDIZATION.PR_LINK_SUB_MASTER_FACILITY(
			#{subFacilityId,    jdbcType=BIGINT,  mode=IN},
			#{masterFacilityId, jdbcType=BIGINT,  mode=IN},
			#{statusCode,       jdbcType=INTEGER, mode=OUT},
			#{statusMessage,        jdbcType=VARCHAR, mode=OUT}	 
		)}
 </select>
</mapper>